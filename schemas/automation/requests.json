{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arc:automation:1.0:requests",
  "title": "Arc Automation Protocol 1.0: requests",
  "description": "A request line of the methods provided by arc-command; `params` follows the definition named after the method.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method"
  ],
  "$defs": {
    "arc.initialize": {
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersions": {
          "type": "object",
          "properties": {
            "min": {
              "type": "string"
            },
            "max": {
              "type": "string"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "edit",
              "file_read",
              "file_write",
              "network",
              "process",
              "settings"
            ]
          }
        }
      },
      "required": [
        "clientName",
        "protocolVersions"
      ],
      "additionalProperties": true
    },
    "arc.shutdown": {
      "type": "object"
    },
    "arc.ping": {
      "type": "object"
    },
    "arc.capabilities": {
      "type": "object"
    },
    "command.list": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "command.describe": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "document": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": true
    },
    "command.validate": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": true
    },
    "command.run": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "preview": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "document",
        "command"
      ],
      "additionalProperties": true
    },
    "command.cancel": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "event.subscribe": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "command.progress",
              "document.changed",
              "selection.changed"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "document": {
          "type": "string"
        }
      },
      "required": [
        "events"
      ],
      "additionalProperties": true
    },
    "event.unsubscribe": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "command.progress",
              "document.changed",
              "selection.changed"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "document": {
          "type": "string"
        }
      },
      "required": [
        "events"
      ],
      "additionalProperties": true
    },
    "query.objects": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "owner": {
          "type": "string",
          "format": "uuid"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": true
    },
    "query.references": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "direction": {
          "enum": [
            "both",
            "outgoing",
            "incoming"
          ]
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "document",
        "id"
      ],
      "additionalProperties": true
    },
    "query.diagnostics": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": true
    },
    "query.history": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": true
    },
    "selection.get": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": true
    },
    "selection.set": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "subObjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "document",
        "objects"
      ],
      "additionalProperties": true
    }
  }
}
