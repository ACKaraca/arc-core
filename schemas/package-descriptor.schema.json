{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACKaraca/arc-core/blob/main/schemas/package-descriptor.schema.json",
  "title": "Arc package field descriptor, descriptor_format 1",
  "description": "The JSON field descriptor of one version of one object type, stored in the arc_type.descriptor column of a document package. The grammar is specified in docs/crates/arc-doc.md, section Field descriptors (CORE-DOC-004).",
  "type": "object",
  "required": ["descriptor_format", "type_key", "major", "minor", "fields"],
  "additionalProperties": false,
  "properties": {
    "descriptor_format": { "const": 1 },
    "type_key": { "$ref": "#/$defs/key" },
    "major": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "minor": { "$ref": "#/$defs/u32" },
    "fields": { "$ref": "#/$defs/fields" }
  },
  "$defs": {
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "name": {
      "description": "A lowercase ASCII letter followed by lowercase letters, digits and underscores, at most 64 bytes.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "key": {
      "description": "Two or more names separated by single dots, at most 128 bytes.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "field": {
      "type": "object",
      "required": ["name", "type", "optional", "indexed", "aspect", "default", "bound"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "optional": { "type": "boolean" },
        "indexed": { "type": "boolean" },
        "aspect": { "$ref": "#/$defs/name" },
        "default": {
          "description": "The canonical JSON form of the default value of the field's type, or null for none."
        },
        "bound": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "min", "max"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "int" },
                "min": { "type": "integer" },
                "max": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "min", "max"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "real" },
                "min": { "type": "number" },
                "max": { "type": "number" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "max"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "length" },
                "max": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "simple": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bool",
            "i64",
            "f64",
            "string",
            "point2",
            "point3",
            "vector3",
            "transform",
            "color",
            "external_reference",
            "asset",
            "opaque"
          ]
        }
      }
    },
    "type": {
      "oneOf": [
        { "$ref": "#/$defs/simple" },
        {
          "type": "object",
          "required": ["kind", "dimension"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "quantity" },
            "dimension": {
              "description": "The exponents of length, mass, time, electric current, temperature, amount of substance, luminous intensity, angle and solid angle.",
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": { "type": "integer", "minimum": -128, "maximum": 127 }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "variants"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "enum" },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "code"],
                "additionalProperties": false,
                "properties": {
                  "name": { "$ref": "#/$defs/name" },
                  "code": { "$ref": "#/$defs/u32" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "targets", "rule"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "reference" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/key" } },
            "rule": { "$ref": "#/$defs/rule" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "encoding", "encoding_version"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "geometry" },
            "encoding": { "$ref": "#/$defs/key" },
            "encoding_version": { "$ref": "#/$defs/u32" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "element"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "list" },
            "element": { "$ref": "#/$defs/type" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "map" },
            "value": { "$ref": "#/$defs/type" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "record" },
            "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["strength", "on_delete", "on_copy", "cardinality"],
      "additionalProperties": false,
      "properties": {
        "strength": { "enum": ["owning", "associative", "informational"] },
        "on_delete": { "enum": ["cascade", "clear", "block"] },
        "on_copy": { "enum": ["copy_target", "share_target", "clear"] },
        "cardinality": { "enum": ["one", "optional", "many"] },
        "max": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "oneOf": [
        {
          "required": ["max"],
          "properties": { "cardinality": { "const": "many" } }
        },
        {
          "properties": { "cardinality": { "enum": ["one", "optional"] }, "max": false }
        }
      ]
    }
  }
}
