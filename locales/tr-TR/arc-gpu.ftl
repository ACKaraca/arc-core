# arc-gpu tarafından sahip olunan hataların iletileri. Tanımlayıcılar
# crates/arc-gpu/src/error.rs içinde kayıtlıdır.

gpu-adapter-not-found = Ayarlara uyan bir grafik bağdaştırıcısı yok.
gpu-settings-invalid = Bir görüntüleme ayarı aralığın dışında.
gpu-device-request-failed = Grafik aygıtı oluşturulamadı.
gpu-device-lost = Grafik aygıtı kaybedildi.
gpu-out-of-memory = Grafik aygıtının belleği tükendi.
gpu-validation = Grafik aygıtı bir işlemi reddetti.
gpu-timeout = Grafik aygıtı zamanında yanıt vermedi.
gpu-readback-failed = Çizilen görüntü geri okunamadı.
gpu-limit-exceeded = Sahne veya görüntü sınırın izin verdiğinden büyük.
gpu-value-not-finite = Sahnenin bir değeri sonlu bir sayı değil.
gpu-item-invalid = Bir çizim öğesi boş veya geçersiz bir stile sahip.
gpu-geometry-invalid = Ağda hiç üçgen yok.
gpu-geometry-not-found = Geometri sahnede yok.
gpu-geometry-in-use = Geometri hâlâ çizim öğeleri tarafından kullanılıyor.
gpu-precision-insufficient = Görünüm yeterli duyarlılıkla gösterilemiyor.
gpu-pick-invalid = Seçim bölgesi veya toleransı geçersiz.
gpu-navigation-invalid = Bir gezinme değeri aralığın dışında.
gpu-extractor-panicked = Bir çizim çıkarıcısı beklenmedik şekilde başarısız oldu.
gpu-thread-failed = Bir çizim iş parçacığı çalıştırılamadı.
