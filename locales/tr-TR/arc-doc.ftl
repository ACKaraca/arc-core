# arc-doc tarafından sahip olunan hataların iletileri. Tanımlayıcılar
# crates/arc-doc/src/error.rs içinde kayıtlıdır.

doc-type-duplicate-key = { $key } nesne türü zaten kayıtlı.
doc-type-malformed-key = { $key } geçerli bir anahtar değil: noktalarla ayrılmış iki veya daha fazla küçük harfli ad kullanın.
doc-type-version-invalid = { $type } nesne türünün şema sürümü geçersiz.
doc-type-duplicate-field = { $field } alanı iki kez bildirilmiş.
doc-type-field-invalid = { $field } alanının bildirimi geçerli değil.
doc-type-relationship-inconsistent = { $field } alanının ilişki kuralı alana uymuyor.
doc-type-default-invalid = { $field } alanının varsayılan değeri alana uymuyor.
doc-type-migration-chain-invalid = { $type } nesne türü, önceki her ana sürümden tam olarak bir dönüştürme gerektirir.
doc-value-missing = { $field } alanı bir değer gerektiriyor.
doc-value-type-mismatch = { $field } alanının değeri yanlış türde.
doc-value-out-of-range = { $field } alanının değeri geçerli aralığın dışında.
doc-value-not-finite = { $field } alanının değeri sonlu bir sayı değil.
doc-payload-invalid = Saklanan nesne verisi hasarlı.
doc-payload-limit-exceeded = Saklanan nesne verisi bir boyut sınırını aşıyor.
doc-payload-encoding-unsupported = Saklanan nesne verisi, bu sürümün okuyamadığı bir kodlama kullanıyor.
doc-object-not-found = Nesne yok.
doc-reference-dangling = Bir başvuru, var olmayan veya türü yanlış olan bir nesneyi gösteriyor.
doc-type-unknown = { $type } nesne türü kayıtlı değil.
doc-object-duplicate-id = { $id } tanımlayıcılı bir nesne zaten var.
doc-store-capacity-exceeded = Belge, { $type } türünde daha fazla nesne tutamaz.
doc-snapshot-stale = Değişiklikler belgenin eskimiş bir durumu üzerinde yapıldı.
doc-savepoint-invalid = Kayıt noktası bu değişikliklere ait değil veya artık kullanılamıyor.
doc-path-invalid = { $path } yolu nesnenin bir değerini göstermiyor.
doc-txn-limit-exceeded = Değişiklik tek bir işlem için çok büyük ({ $limit }); daha küçük adımlara bölün.
doc-op-mismatch = Değişiklik nesnenin geçerli durumuna uymuyor.
doc-reference-delete-blocked = Nesne silinemez: başka bir nesnenin { $field } alanı ona başvuruyor ve silinmesine izin vermiyor.
doc-reference-cascade-limit = Bu nesnelerin silinmesi { $limit } değerinden fazla bağlı nesneyi silerdi.
doc-reference-cardinality = { $field } alanı, ilişki kuralının izin vermediği sayıda başvuru tutuyor.
doc-reference-owner-conflict = { $field } alanı, başka bir başvurunun zaten sahip olduğu bir nesneye sahip olamaz.
doc-load-newer-major = Belge, desteklenen { $current } sürümünden daha yeni olan { $type } { $version } sürümünü içeriyor; açılamaz.
doc-load-limit-exceeded = Belge açılamayacak kadar büyük ({ $limit }).
doc-load-version-undeclared = Bir { $type } nesnesi, belgenin bildirmediği { $version } sürümünü belirtiyor.
doc-load-header-invalid = Saklanan bir nesnenin { $column } değeri geçersiz.
doc-migration-failed = Bir { $type } nesnesi { $from } sürümünden yükseltilemedi.
doc-object-not-modifiable = { $id } nesnesi korunuyor veya karantinada ve değiştirilemez.
doc-document-read-only = Belge salt okunur açık: { $type }, daha yeni olan { $version } sürümüyle yazılmış.
doc-graph-malformed-key = Türetilmiş { $key } anahtarı geçerli bir anahtar değil.
doc-graph-duplicate-key = Türetilmiş { $key } anahtarı için bir değerlendirici zaten kayıtlı.
doc-graph-unknown-key = Bu nesne için { $key } değerini hesaplayan bir değerlendirici yok.
doc-graph-cycle = { $node } türetilmiş verisi { $members } üzerinden kendine bağlı.
doc-graph-blocked = { $node } türetilmiş verisi hesaplanamıyor çünkü bir girdi başarısız oldu.
doc-graph-depth-exceeded = Türetilmiş verinin hesaplanması { $limit } değerinden fazla iç içe adım gerektiriyor.
doc-graph-stale = { $node } türetilmiş verisi belgenin eskimiş bir durumundan hesaplandı.
doc-load-validator-panicked = { $type } için bir doğrulayıcı beklenmedik şekilde başarısız oldu; nesne salt okunur tutuluyor.
doc-object-read-only = { $id } nesnesi salt okunur.
doc-executor-fault = Bir komut bir hata nedeniyle başarısız oldu; belge değiştirilmeden bırakıldı.
doc-executor-stopped = Komut çalışamadan belge kapatıldı.
doc-journal-record-invalid = Bir geçmiş kaydı hasarlı veya bu belgenin nesne türlerine uymuyor.
doc-journal-record-limit-exceeded = Bir geçmiş kaydı okunamayacak kadar büyük ({ $limit }).
doc-journal-duplicate-txn = { $id } değişikliği geçmişte zaten var.
doc-journal-parent-mismatch = { $id } değişikliği geçmişteki son değişikliği izlemiyor.
doc-undo-state-mismatch = Belge artık bu geri alma veya yinelemenin beklediği durumda değil.
doc-undo-sequence-invalid = Geri alma geçmişi şu anda bunu yapamaz: { $reason }.
doc-package-not-a-package = { $path } dosyası bir Arc paketi değil.
doc-package-newer-format = Paket, desteklenen { $current } biçiminden daha yeni olan { $version } biçimini kullanıyor; açılamaz.
doc-package-schema-invalid = Paket hasarlı: { $table } eksik veya hatalı.
doc-package-value-invalid = Paket hasarlı: { $table }.{ $column } içindeki bir değer geçersiz.
doc-package-hash-mismatch = Saklanan { $id } nesnesi sağlama toplamıyla uyuşmuyor.
doc-package-io-failed = { $path } paket dosyası okunamadı veya yazılamadı.
doc-package-corrupt = { $path } paket dosyası hasarlı.
doc-package-verify-failed = { $path } dosyasının kaydedilen kopyası doğrulamadan geçemedi; dosya değiştirilmedi.
doc-package-exists = { $path } dosyası zaten var.
doc-package-locked = Paket, { $host } üzerinde { $user } tarafından düzenleniyor.
doc-package-preview-invalid = { $kind } önizleme görüntüsü geçersiz.
doc-package-last-txn-missing = { $id } nesnesinin kayıtlı bir işlemi yok.
doc-package-meta-invalid = { $key } paket üst verisi girdisi geçersiz.
doc-scheduler-stopped = Türetilmiş veri hesaplanamadan belge kapatıldı.
doc-graph-evaluator-panicked = { $node } türetilmiş verisinin hesaplanması bir hata nedeniyle başarısız oldu.
doc-recovery-unavailable = Kurtarma koruması kapalı ({ $path }); kaydedilmemiş değişiklikler çökmeye karşı korunmuyor.
doc-recovery-invalid = { $path } kurtarma dosyası hasarlı veya bir kurtarma dosyası değil.
doc-recovery-locked = { $path } kurtarma dosyası çalışan bir oturum tarafından kullanılıyor.
doc-recovery-base-missing = Kurtarılan değişikliklerin uygulandığı { $path } belgesi değişmiş ve bir kopyası tutulmamış.
doc-recovery-truncated = Kurtarma { $seq } değişikliğinde durdu: kurtarma dosyasının geri kalanı hasarlı veya uygulanamıyor.
doc-package-incremental-refused = Paket yerinde kaydedilemiyor ({ $reason }); tamamı yeniden yazılacak.
doc-package-asset-not-found = Pakette { $hash } varlığı yok.
doc-package-asset-corrupt = Saklanan { $hash } varlığı hasarlı.
doc-package-save-panicked = Belgenin kaydedilmesi bir hata nedeniyle başarısız oldu; dosya değiştirilmedi.
doc-descriptor-invalid = Saklanan bir tür açıklaması geçersiz.
doc-package-recovery-needed = { $path } paketi yarım kalmış bir kayıttan arta kalmış; geri yüklemek için düzenlemek üzere açın.
doc-package-index-mismatch = { $id } nesnesinin saklanan { $table } dizini nesneyle uyuşmuyor.
