# arc-draft tarafından sahip olunan hata iletileri ile komutlarının adları ve açıklamaları.
# Hata tanımlayıcıları crates/arc-draft/src/error.rs, komut tanımlayıcıları
# crates/arc-draft/src/commands.rs içinde kayıtlıdır.

draft-geometry-invalid = Saklanan geometri, bu nesnenin tuttuğu türde geçerli bir eğri değil.
draft-extrusion-zero = Ekstrüzyon yönünün uzunluğu yok.
draft-space-layout-unitless = Bir yerleşim bir uzunluk birimi belirtmelidir.
draft-linetype-pattern-empty = Bir çizgi tipi deseni, negatif olmayan ve toplamı sıfırdan büyük uzunluklar gerektirir.
draft-linetype-scale-invalid = Çizgi tipi ölçeği pozitif bir sayı olmalıdır.
draft-block-scale-zero = Bir blok başvurusu sıfırla ölçeklenemez.
draft-block-cycle = Blok tanımları birbirini içerir hâle gelirdi.
draft-block-nesting-too-deep = Blok başvuruları { $limit } düzeyden daha derin iç içe geçmiş.
draft-block-attribute-unknown = Blok tanımında { $tag } özniteliği yok.
draft-name-taken = { $name } adı zaten kullanılıyor.
draft-object-wrong-type = Nesne bu işlemin kabul ettiği türden değil.
draft-field-invalid = Değer { $field } alanına uymuyor.
draft-order-reference-moved = Bir nesne kendisinin üstüne veya altına yerleştirilemez.
draft-order-container-mismatch = Nesneler aynı alanda veya blok tanımında değil.
draft-layout-margins-invalid = Kenar boşlukları paftada yazdırılabilir alan bırakmıyor.
draft-layout-window-invalid = Yazdırılan bir pencerenin sol alt köşesi sağ üst köşesinin altında ve solunda olmalıdır.
draft-layout-owner-invalid = Yerleşim ayarları ve görünüm alanları bir yerleşime ait olmalıdır.
draft-layout-duplicate = Yerleşimin zaten ayarları var.
draft-viewport-clip-invalid = Görünüm alanı kırpma sınırı kapalı bir çoklu çizgi olmalıdır.
draft-viewport-locked = Kilitli bir görünüm alanının görünümü değiştirilemez.
draft-wipeout-boundary-open = Bir maskeleme sınırı kapalı bir çoklu çizgi olmalıdır.
draft-style-parent-invalid = Tek bir tür için ölçülendirme stili, tüm türler için bir stili ayrıntılandırmalıdır.
draft-purge-in-use = Nesne kullanımda olduğu için temizlenemez.
draft-display-too-large = Görüntü listesi { $limit } öğeden fazlasını tutardı.
draft-font-syntax = Çizgi yazı tipi dosyasının { $line }. satırı bozuk.
draft-font-version-unsupported = Çizgi yazı tipi biçiminin { $version } sürümü desteklenmiyor.
draft-font-header-invalid = Çizgi yazı tipi başlığındaki { $key } değeri eksik, yinelenmiş veya geçersiz.
draft-font-glyph-duplicate = Çizgi yazı tipi { $glyph } glifini iki kez tanımlıyor.
draft-font-glyph-unknown = Çizgi yazı tipi tanımlamadığı { $glyph } glifine başvuruyor.
draft-font-glyph-out-of-bounds = Çizgi yazı tipinin { $glyph } glifi kutusunun dışına çıkıyor.
draft-font-limit-exceeded = Çizgi yazı tipi dosyası { $limit } sınırını aşıyor.
draft-font-default-missing = Varsayılan çizgi yazı tipi { $name } kullanılamıyor.
draft-font-substituted = { $requested } yazı tipi kullanılamıyor; yerine { $used } kullanılıyor.
draft-font-outline-invalid = Anahat yazı tipi okunamıyor veya yerleşimde kullanılamıyor.
draft-text-content-invalid = Yazı bir denetim karakteri veya aralık dışında bir değer içeriyor.
draft-text-too-large = Yazı { $limit } sınırını aşıyor.
draft-text-stack-invalid = Yığılmış kesrin bir paydası olmalı; payda yalnızca yığılmış kesirde bulunur.
draft-text-tabs-invalid = Sekme durakları pozitif ve artan sırada olmalı.
draft-dimension-points-invalid = Ölçülendirmenin tanım noktası sayısı türünün gerektirdiği sayıda değil.
draft-dimension-degenerate = Ölçülendirmenin tanım noktaları bir ölçü tanımlamıyor.
draft-dimension-reference-invalid = Başvurulan geometri ölçülendirme için bir nokta vermiyor.
draft-dimension-disassociated = Ölçülendirme ölçtüğü geometriyi kaybetti ve son noktalarını koruyor.
draft-chain-member-invalid = Bir ölçülendirme zinciri yalnızca doğrusal ve hizalı ölçülendirmeleri, her birini bir kez tutar.
draft-annotation-scale-invalid = Bir açıklama ölçeği bir kez listelenen pozitif bir sayı olmalıdır.
draft-leader-points-invalid = Açıklama çizgisinin yeterli noktası yok.
draft-plot-style-entry-invalid = Bir çizim stilinin, renk eşlemeli tabloda bir dizini, adlandırılmış tabloda bir adı olmalıdır.
draft-plot-style-duplicate = { $key } çizim stili anahtarı birden fazla kez listelenmiş.
draft-plot-option-invalid = { $option } çizim seçeneği aralığın dışında veya çizilecek bir alan bırakmıyor.
draft-plot-source-invalid = Yalnızca yerleşim ayarları olan bir yerleşim veya bir çizim alanı çizdirilebilir.
draft-plot-too-large = Çizdirme { $limit } öğeden fazlasını tutardı.
draft-raster-invalid = { $option } raster seçeneği aralığın dışında.
draft-raster-too-large = Görüntü { $limit } pikselden fazlasına sahip olurdu.
draft-raster-encode-failed = Görüntü kodlanamadı.

