# Messages owned by arc-draft: its error codes and the labels and descriptions of its commands.
# Error identifiers are registered in crates/arc-draft/src/error.rs, command identifiers in
# crates/arc-draft/src/commands.rs.

draft-geometry-invalid = The stored geometry is not a valid curve of the kind this object holds.
draft-extrusion-zero = The extrusion direction has no length.
draft-space-layout-unitless = A layout must declare a length unit.
draft-linetype-pattern-empty = A linetype pattern needs lengths that are not negative and add up to more than zero.
draft-linetype-scale-invalid = A linetype scale must be a positive number.
draft-block-scale-zero = A block reference cannot be scaled by zero.
draft-block-cycle = The block definitions would contain each other.
draft-block-nesting-too-deep = Block references are nested more than { $limit } levels deep.
draft-block-attribute-unknown = The block definition has no attribute { $tag }.
draft-name-taken = The name { $name } is already in use.
draft-object-wrong-type = The object is not of a kind this operation accepts.
draft-field-invalid = The value does not fit the field { $field }.
draft-order-reference-moved = An object cannot be placed above or below itself.
draft-order-container-mismatch = The objects are not in the same space or block definition.
draft-layout-margins-invalid = The margins leave no printable area on the sheet.
draft-layout-window-invalid = A plotted window needs a lower left corner below and left of its upper right corner.
draft-layout-owner-invalid = Layout settings and viewports must belong to a layout.
draft-layout-duplicate = The layout already has settings.
draft-viewport-clip-invalid = A viewport clip boundary must be a closed polyline.
draft-viewport-locked = The view of a locked viewport cannot change.
draft-wipeout-boundary-open = A wipeout boundary must be a closed polyline.
draft-style-parent-invalid = A dimension style for one kind must refine a style for all kinds.
draft-purge-in-use = The object is in use and cannot be purged.
draft-display-too-large = The display list would hold more than { $limit } primitives.
draft-font-syntax = Line { $line } of the stroke-font file is malformed.
draft-font-version-unsupported = Stroke-font format version { $version } is not supported.
draft-font-header-invalid = The stroke-font header value { $key } is missing, repeated or invalid.
draft-font-glyph-duplicate = The stroke font defines glyph { $glyph } twice.
draft-font-glyph-unknown = The stroke font refers to glyph { $glyph }, which it does not define.
draft-font-glyph-out-of-bounds = Glyph { $glyph } of the stroke font leaves its box.
draft-font-limit-exceeded = The stroke-font file exceeds the bound { $limit }.
draft-font-default-missing = The default stroke font { $name } is not available.
draft-font-substituted = The font { $requested } is not available; { $used } is used instead.
draft-font-outline-invalid = The outline font cannot be read or used for layout.
draft-text-content-invalid = The text holds a control character or a value out of range.
draft-text-too-large = The text exceeds the limit on { $limit }.
draft-text-stack-invalid = A stacked fraction needs a denominator, and only a stacked fraction has one.
draft-text-tabs-invalid = Tab stops must be positive and ascending.
draft-dimension-points-invalid = The dimension does not have the number of definition points its kind needs.
draft-dimension-degenerate = The definition points of the dimension do not define a measurement.
draft-dimension-reference-invalid = The referenced geometry does not give a point for the dimension.
draft-dimension-disassociated = The dimension lost the geometry it measured and keeps its last points.
draft-chain-member-invalid = A dimension chain holds only linear and aligned dimensions, each once.
draft-annotation-scale-invalid = An annotation scale must be a positive number listed once.
draft-leader-points-invalid = The leader does not have enough points.
draft-plot-style-entry-invalid = A plot style needs an index in a color-mapped table and a name in a named table.
draft-plot-style-duplicate = The plot style key { $key } is listed more than once.
draft-plot-option-invalid = The plot option { $option } is out of range or leaves no area to plot.
draft-plot-source-invalid = Only a layout space with layout settings, or a space, can be plotted.
draft-plot-too-large = The plot would hold more than { $limit } items.
draft-raster-invalid = The raster option { $option } is out of range.
draft-raster-too-large = The image would have more than { $limit } pixels.
draft-raster-encode-failed = The image could not be encoded.

draft-command-space-create = New space
draft-command-space-create-description = Creates a model space or layout with a declared unit.
draft-command-space-modify = Change space
draft-command-space-modify-description = Sets a field of model spaces or layouts.
draft-command-entity-create = New drawing object
draft-command-entity-create-description = Creates a point or curve in a space or block definition.
draft-command-entity-modify = Change drawing objects
draft-command-entity-modify-description = Sets a field of drawing objects.
draft-command-entity-delete = Delete drawing objects
draft-command-entity-delete-description = Deletes drawing objects.
draft-command-layer-create = New layer
draft-command-layer-create-description = Creates a layer.
draft-command-layer-modify = Change layers
draft-command-layer-modify-description = Sets a field of layers.
draft-command-layer-delete = Delete layers
draft-command-layer-delete-description = Deletes layers that no object uses.
draft-command-linetype-load = Load linetype
draft-command-linetype-load-description = Adds a linetype definition from its pattern.
draft-command-linetype-modify = Change linetypes
draft-command-linetype-modify-description = Sets a field of linetype definitions.
draft-command-block-define = Define block
draft-command-block-define-description = Creates a block definition and moves the given objects into it.
draft-command-block-modify = Change block definitions
draft-command-block-modify-description = Sets a field of block definitions.
draft-command-block-insert = Insert block
draft-command-block-insert-description = Places a reference to a block definition.
draft-command-order-front = Bring to front
draft-command-order-front-description = Draws the objects after every other object of their space.
draft-command-order-back = Send to back
draft-command-order-back-description = Draws the objects before every other object of their space.
draft-command-order-above = Bring above object
draft-command-order-above-description = Draws the objects directly after another object.
draft-command-order-below = Send below object
draft-command-order-below-description = Draws the objects directly before another object.
draft-command-layout-create = New layout
draft-command-layout-create-description = Creates a layout with its paper size and default plot settings.
draft-command-layout-modify = Change layout settings
draft-command-layout-modify-description = Sets a paper or plot setting of layouts.
draft-command-viewport-create = New viewport
draft-command-viewport-create-description = Places a viewport on a layout that shows a space at a scale.
draft-command-viewport-modify = Change viewports
draft-command-viewport-modify-description = Sets a field of viewports; the view of a locked viewport stays.
draft-command-viewport-delete = Delete viewports
draft-command-viewport-delete-description = Deletes viewports.
draft-command-wipeout-create = New wipeout
draft-command-wipeout-create-description = Creates a region that hides what is drawn beneath it.
draft-command-style-create = New style
draft-command-style-create-description = Creates a text, dimension, leader or table style.
draft-command-style-modify = Change styles
draft-command-style-modify-description = Sets a field of styles.
draft-command-style-delete = Delete styles
draft-command-style-delete-description = Deletes styles that no object uses.
draft-command-style-defaults = Create default styles
draft-command-style-defaults-description = Creates a default style of each kind that has none.
draft-command-purge = Purge
draft-command-purge-description = Deletes unused layers, linetypes, block definitions and styles.
draft-command-text-create = New text
draft-command-text-create-description = Creates a single line of text at a position.
draft-command-rich-text-create = New rich text
draft-command-rich-text-create-description = Creates multi-line text from paragraphs or from plain text.
draft-command-rich-text-set = Replace rich text content
draft-command-rich-text-set-description = Replaces the paragraphs of rich texts.
draft-command-font-substitute = Substitute font
draft-command-font-substitute-description = Sets or removes the font the document uses in place of an unavailable one.
draft-command-dimension-create = New dimension
draft-command-dimension-create-description = Creates a dimension from definition points that are free or reference geometry.
draft-command-chain-create = New dimension chain
draft-command-chain-create-description = Groups linear dimensions into a baseline or continued chain and spaces them.
draft-command-chain-add = Add to dimension chain
draft-command-chain-add-description = Adds a dimension at the end of a chain and spaces the chain again.
draft-command-chain-remove = Remove from dimension chain
draft-command-chain-remove-description = Removes a dimension from a chain and spaces the chain again.
draft-command-chain-respace = Space dimension chain
draft-command-chain-respace-description = Sets the spacing of a chain and places its dimension lines again.
draft-command-leader-create = New leader
draft-command-leader-create-description = Creates a leader through points with an arrowhead and a landing.
draft-command-multileader-create = New multi-leader
draft-command-multileader-create-description = Creates leader lines that share one landing and text, block or tolerance frame content.
draft-command-annotation-scales = Set annotation scales
draft-command-annotation-scales-description = Adds or removes annotation scale representations of annotative objects.
draft-command-spline-create = New spline
draft-command-spline-create-description = Creates a spline from control points and a degree, or through fit points.
draft-command-spline-set = Change splines
draft-command-spline-set-description = Replaces the curve of splines with one from control points or fit points.
draft-command-plot-style-table-create = New plot style table
draft-command-plot-style-table-create-description = Creates a color-mapped or named plot style table with its styles.
draft-command-plot-style-table-modify = Change plot style tables
draft-command-plot-style-table-modify-description = Sets a field of plot style tables.
draft-command-plot-style-table-delete = Delete plot style tables
draft-command-plot-style-table-delete-description = Deletes plot style tables.
