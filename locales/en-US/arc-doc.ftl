# Messages of the errors owned by arc-doc. Identifiers are registered in
# crates/arc-doc/src/error.rs.

doc-type-duplicate-key = The object type { $key } is already registered.
doc-type-malformed-key = { $key } is not a valid key: use two or more lowercase names separated by dots.
doc-type-version-invalid = The object type { $type } has an invalid schema version.
doc-type-duplicate-field = The field { $field } is declared twice.
doc-type-field-invalid = The declaration of the field { $field } is not valid.
doc-type-relationship-inconsistent = The relationship rule of the field { $field } does not fit the field.
doc-type-default-invalid = The default value of the field { $field } does not fit the field.
doc-type-migration-chain-invalid = The object type { $type } needs exactly one migration from each earlier major version.
doc-value-missing = The field { $field } needs a value.
doc-value-type-mismatch = The value of the field { $field } has the wrong type.
doc-value-out-of-range = The value of the field { $field } is outside its valid range.
doc-value-not-finite = The value of the field { $field } is not a finite number.
doc-payload-invalid = The stored object data is damaged.
doc-payload-limit-exceeded = The stored object data exceeds a size limit.
doc-payload-encoding-unsupported = The stored object data uses an encoding this version cannot read.
doc-object-not-found = The object does not exist.
doc-reference-dangling = A reference points to an object that does not exist or has the wrong type.
doc-type-unknown = The object type { $type } is not registered.
doc-object-duplicate-id = An object with the identifier { $id } already exists.
doc-store-capacity-exceeded = The document cannot hold more objects of the type { $type }.
doc-snapshot-stale = The changes were made on an outdated state of the document.
doc-savepoint-invalid = The savepoint does not belong to these changes or is no longer available.
doc-path-invalid = The path { $path } does not address a value of the object.
doc-txn-limit-exceeded = The change is too large for one transaction ({ $limit }); split it into smaller steps.
doc-op-mismatch = The change does not fit the current state of the object.
doc-reference-delete-blocked = The object cannot be deleted: the field { $field } of another object refers to it and does not allow the deletion.
doc-reference-cascade-limit = Deleting these objects would delete more than { $limit } dependent objects.
doc-reference-cardinality = The field { $field } holds a number of references that its relationship rule does not allow.
doc-reference-owner-conflict = The field { $field } cannot own an object that another reference already owns.
doc-load-newer-major = The document contains { $type } version { $version }, newer than the supported version { $current }; it cannot be opened.
doc-load-limit-exceeded = The document is too large to open ({ $limit }).
doc-load-version-undeclared = An object of { $type } names version { $version }, which the document does not declare.
doc-load-header-invalid = A stored object has an invalid { $column }.
doc-migration-failed = An object of { $type } could not be upgraded from version { $from }.
doc-object-not-modifiable = The object { $id } is preserved or quarantined and cannot be changed.
doc-document-read-only = The document is open read-only: { $type } was written by the newer version { $version }.
doc-graph-malformed-key = The derived key { $key } is not a valid key.
doc-graph-duplicate-key = An evaluator for the derived key { $key } is already registered.
doc-graph-unknown-key = No evaluator computes { $key } for this object.
doc-graph-cycle = The derived data { $node } depends on itself through { $members }.
doc-graph-blocked = The derived data { $node } cannot be computed because an input failed.
doc-graph-depth-exceeded = Computing the derived data needs more than { $limit } nested steps.
doc-graph-stale = The derived data { $node } was computed from an outdated state of the document.
doc-load-validator-panicked = A validator of { $type } failed unexpectedly; the object is kept read-only.
doc-object-read-only = The object { $id } is read-only.
doc-executor-fault = A command failed because of a defect; the document was left unchanged.
doc-executor-stopped = The document was closed before the command could run.
doc-journal-record-invalid = A history record is damaged or does not fit this document's object types.
doc-journal-record-limit-exceeded = A history record is too large to read ({ $limit }).
doc-journal-duplicate-txn = The change { $id } is already in the history.
doc-journal-parent-mismatch = The change { $id } does not follow the last change in the history.
doc-undo-state-mismatch = The document no longer holds the state this undo or redo expects.
doc-undo-sequence-invalid = The undo history cannot do this now: { $reason }.
