# Messages of the errors owned by arc-command. Identifiers are registered in
# crates/arc-command/src/error.rs.

cmd-unknown = No command is named { $name }.
cmd-spec-invalid = The command specification cannot be registered.
cmd-duplicate = The name { $name } is already registered.
cmd-alias-invalid = { $alias } is not a valid alias.
cmd-alias-unknown = There is no alias { $alias }.
cmd-alias-deprecated = { $alias } is a deprecated name of { $command }.
cmd-name-ambiguous = The name { $name } matches several commands.
cmd-params-malformed = The parameters are not valid JSON.
cmd-params-limit-exceeded = The parameters exceed a size or depth limit.
cmd-params-invalid = { $count } parameter values are not valid.
cmd-disabled = The command { $command } is not available now.
cmd-permission-denied = The command { $command } needs a permission this session does not have.
cmd-not-exposed = The command { $command } is not available here.
cmd-cancelled = The command was cancelled; nothing was changed.
cmd-fault = The command failed unexpectedly; the document was restored.
cmd-result-invalid = The command produced an invalid result; nothing was changed.
cmd-no-transaction = The command tried to change the document without a transaction.
cmd-prompt-kind = This prompt does not accept that input.
cmd-prompt-range = The value is outside the allowed range.
cmd-prompt-object = The object does not exist or cannot be used here.
cmd-prompt-unreadable = The input cannot be read here.
cmd-prompt-no-default = This prompt has no default.
cmd-prompt-invalid = The command asked for input it cannot accept.
cmd-prompt-limit-exceeded = The input exceeds a size or count limit.
cmd-prompt-ended = No command is waiting for input.
cmd-line-syntax = The command line cannot be read.
cmd-line-limit-exceeded = The command line is too long or too deeply nested.
cmd-line-unknown-param = The command has no parameter { $name }.
cmd-line-duplicate-param = The parameter { $name } is given twice.
cmd-line-too-many-values = The command line has more values than the command takes.
cmd-line-value = The value of { $name } is not valid.
cmd-repeat-none = There is no command to repeat.

# Prompt messages of machines derived from parameter schemas.
cmd-prompt-param = Enter { $name }.
cmd-keyword-yes = Yes
cmd-keyword-no = No
cmd-keyword-value = { $value }
cmd-protocol-parse = The message is not valid JSON text.
cmd-protocol-invalid-request = The message is not a valid request.
cmd-protocol-method-unknown = There is no method { $method }.
cmd-protocol-method-unsupported = The method { $method } is not available in this application.
cmd-protocol-invalid-params = The parameters of { $method } are not valid.
cmd-protocol-internal = The request failed unexpectedly.
cmd-protocol-limit-exceeded = The message exceeds a size, depth or count limit.
cmd-protocol-not-initialized = The session must be initialized first.
cmd-protocol-already-initialized = The session is already initialized.
cmd-protocol-version-unsupported = No supported protocol version is in the requested range.
cmd-document-unknown = There is no open document { $document }.
cmd-revision-mismatch = The document changed since revision { $expected }.
cmd-preview-unsupported = The command controls undo and cannot run as a preview.
cmd-preview-rollback-failed = The preview could not be rolled back and remains as an undoable step.
cmd-query-cursor-invalid = The cursor does not belong to this query.
cmd-query-cursor-stale = The document changed since revision { $expected }; the cursor is no longer valid.
cmd-selection-unknown = { $count } selected objects do not exist in the document.
cmd-roots-invalid = A file root is not an existing folder.
cmd-path-rejected = The path is not acceptable.
cmd-path-too-long = The path is too long.
cmd-path-outside-roots = The path is outside the allowed folders.
cmd-path-not-found = The file or folder does not exist.
cmd-path-io = The file cannot be accessed.
cmd-cli-usage = The command-line arguments are not valid.
cmd-macro-malformed = Line { $line } of the macro is not valid.
cmd-macro-version-unsupported = The macro format version { $version } is not supported.
cmd-macro-limit-exceeded = The macro exceeds a size or count limit.
cmd-socket-disabled = Automation is not enabled.
cmd-socket-unauthorized = The connection was refused.
cmd-socket-unsupported = Local automation connections are not available on this platform yet.
cmd-socket-directory = The folder for the automation connection is not private to you.
cmd-socket-io = The automation connection could not be set up.
cmd-render-unavailable = No renderer is available to draw a view.
cmd-render-size-exceeded = The requested size is above the limit; the detail { $limit } names it.
cmd-render-too-large = The image is too large to return inline; the detail { $limit } names the bound. Write it to a file with the path parameter instead.
cmd-render-unsupported = The renderer cannot draw the requested { $feature }.
cmd-transparent-refused = The command cannot run while another command is active.
cmd-macro-input-missing = The macro input { $input } has no value.
