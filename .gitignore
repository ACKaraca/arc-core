# Rust
/target/
**/*.rs.bk
*.pdb

# Local notes and scratch space (never committed)
/plan/
/.local/

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example

# IFC schema tables generated by `cargo xtask ifc-schema`. Only the IFC4X3 ADD2 tables are stored
# (CC BY-ND 4.0, ADR-0018); the IFC2X3 and IFC4 releases are under non-commercial terms, so their
# tables stay local.
/crates/arc-io-ifc/src/schema/generated/*
!/crates/arc-io-ifc/src/schema/generated/ifc4x3.rs
