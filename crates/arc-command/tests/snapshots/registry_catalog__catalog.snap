      "id": "test.item.create",
      "keywords": null,
      "label": "test-create",
      "params": {
        "$defs": {
          "QuantityParam": {
            "anyOf": [
              {
                "description": "A value in SI base units.",
                "format": "double",
                "type": "number"
              },
              {
                "description": "An expression with units.",
                "type": "string"
              }
            ],
            "description": "A quantity parameter: a number in SI base units, or a text with units parsed by\n`arc-solve` (`\"2400 mm\"`, `\"3'6\\\"\"`), where a bare number takes the session's context unit\nof the dimension. Its schema is `anyOf` number and string."
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "length": {
            "$ref": "#/$defs/QuantityParam"
          },
          "name": {
            "description": "The item name.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "length"
        ],
        "title": "Create",
        "type": "object"
      },
      "permissions": [
        "edit"
      ],
